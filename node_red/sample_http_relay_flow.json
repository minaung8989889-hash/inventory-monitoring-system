    "once": true,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 180,
    "y": 120,
    "wires": [
      ["function-build"]
    ]
  },
  {
    "id": "function-build",
    "type": "function",
    "z": "1a2b3c4d5e6f7g8h",
    "name": "Build relay request",
    "func": "const payload = {
    device_id: 'device-001',
    timestamp: new Date().toISOString(),
    tank: 'TK101',
    level: Math.round(Math.random() * 100),
    temperature: 20 + Math.random() * 10,
    pressure: 1.0 + Math.random() * 0.5,
    volume: 1000 + Math.random() * 100
};
msg.payload = payload;
msg.headers = {
    'Content-Type': 'application/json',
    'x-api-key': 'YOUR_API_KEY_HERE'
};
msg.url = 'http://localhost:5000/api/tanks';
return msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 120,
    "wires": [
      ["http-request-send"]
    ]
  },
  {
    "id": "http-request-send",
