# Development environment variables for backend
# Copy this file to backend/.env and replace values with secure settings.

# MongoDB connection string. Replace localhost with your real MongoDB host.
MONGO_URI=mongodb://mongo:27017/
DATABASE_NAME=IIOT_SCADA

# Secrets
SECRET_KEY=ReplaceWithAStrongSecretValue
ADMIN_SECRET=ReplaceWithAdminSecretValue
API_KEY=ReplaceWithSecureDeveloperApiKey

# CORS and environment
# For one PC hosting both LAN and public access, include both internal and public UI hosts.
# Example: http://localhost:5000,http://192.168.1.10:5000,https://your-public-domain.com
ALLOWED_ORIGINS=http://localhost:5000
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_TOKEN_EXPIRATION_HOURS=72
ENVIRONMENT=development
FORCE_HTTPS=false
